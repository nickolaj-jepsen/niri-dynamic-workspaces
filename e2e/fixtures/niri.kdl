hotkey-overlay {
    skip-at-startup
}

// Deterministic screenshots.
animations {
    off
}

input {
    // Re-focusing the active workspace jumps back, so tests see any the overlay sends.
    workspace-auto-back-and-forth
    keyboard {
        xkb {
            // us stays active; layout tests pick a group with `niri msg action switch-layout <index>`.
            layout "us,fr,ru"
        }
        // niri's defaults, pinned: key-repeat tests hold keys past the delay.
        repeat-delay 600
        repeat-rate 25
    }
}

// The pointer warps to the origin before each click, which would trip the hot corner.
gestures {
    hot-corners {
        off
    }
}
